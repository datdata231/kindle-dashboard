# Non-secret settings, committed to the repo. Secrets (NOTION_TOKEN, GCAL_ICS_URLS,
# ANTHROPIC_API_KEY, DASHBOARD_SLUG) live in GitHub Secrets or a local .env only.
# Workspace: "Dat Data's Notion" → Minimal Dashboard

# Tasks DB
NOTION_TASKS_DB=322847e1909481078c6ac57fed6b6fa2
TASK_PROP_TITLE=Name
TASK_PROP_STATUS=Status
TASK_PROP_DUE=Due
# Statuses that never appear in the checklist or the suggestions
TASK_DONE_VALUES=Done,Ideas
# Overdue tasks older than this drop out of "Hôm nay" and become suggestion candidates
OVERDUE_DAYS=14

# Project DB
NOTION_PROJECTS_DB=324847e1909480c4b0ded49d8d77ec1e
PROJECT_PROP_STAGE=Status
PROJECT_ACTIVE_STAGES=In progress,Not started
STALE_DAYS=10
# Ignore things untouched for longer than this (probably abandoned on purpose)
STALE_MAX_DAYS=365
# Routine/recurring items that should never be suggested as "stalled plans" (regex on the title)
SUGGEST_EXCLUDE=^Tổng kết tuần|recap

# Quotes & Hypotheses (created for the dashboard)
NOTION_QUOTES_DB=03ad13589aba4c2db0a2b0f8e0aff5dc

# Reading: Inbox DB items not yet reviewed
NOTION_READING_DB=322847e1909481f883b0e0149a95b39e
READING_FILTER=Status!=Reviewed

# Health Log (written by the iPhone Shortcut)
NOTION_HEALTH_DB=3c47c81db49347a687cbdc0e9adf8ff4

# Display / place
LAT=21.0285
LON=105.8542
PLACE_NAME=Hà Nội
TZ=Asia/Ho_Chi_Minh
WIDTH=1072
HEIGHT=1448
REFRESH_MINUTES=30
