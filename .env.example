# Copy to .env for local runs. On GitHub, put each value in
# Settings → Secrets and variables → Actions. Never commit real values.

# --- Notion (internal integration token: notion.so/my-integrations) ---
NOTION_TOKEN=
NOTION_TASKS_DB=            # database ID of your task list
NOTION_PROJECTS_DB=         # database ID of projects/plans (for the "stale" suggestions)
NOTION_QUOTES_DB=           # database of quotes / hypotheses (title = the quote)
NOTION_READING_DB=          # database whose pages are the documents to read
NOTION_HEALTH_DB=           # database the iPhone Shortcut writes Health data to

# Property names, if yours differ from the defaults
TASK_PROP_TITLE=Name
TASK_PROP_STATUS=Status
TASK_PROP_DUE=Due date
TASK_DONE_VALUES=Done
PROJECT_PROP_STAGE=Stage
PROJECT_ACTIVE_STAGES=Planning,In Progress
STALE_DAYS=10

# --- Google Calendar: Settings → (your calendar) → "Secret address in iCal format" ---
# Comma-separate several calendars. Turn on "Events from Gmail" so flights,
# bookings and invites from your inbox show up here too.
GCAL_ICS_URLS=

# --- Weather (Open-Meteo, no key needed) ---
LAT=21.0285
LON=105.8542
PLACE_NAME=Hà Nội

# --- Display ---
TZ=Asia/Ho_Chi_Minh
WIDTH=1072                 # Paperwhite 3/4: 1072x1448 · PW5/Signature: 1236x1648 · Basic/PW1-2: 758x1024
HEIGHT=1448
REFRESH_MINUTES=30         # must match the workflow schedule; drives the reading rotation

# --- Optional: smarter "next step" suggestions ---
ANTHROPIC_API_KEY=
